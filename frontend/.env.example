# Copy to .env.local for local `npm run dev` only. Not used by the production build - in
# production the same-origin /api/device and /api/alerting paths are proxied by nginx
# (see nginx.conf.template), configured per-environment through the Helm chart.
VITE_DEV_DEVICE_API_URL=http://localhost:8081
VITE_DEV_ALERTING_API_URL=http://localhost:8082
