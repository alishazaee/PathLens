server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Static, resolved once at startup. If the upstream Service doesn't exist yet the pod
    # will fail its first few restarts and then come up once Kubernetes creates it - normal
    # and expected right after a fresh `helm install` of the whole stack.
    location /api/device/ {
        proxy_pass http://${DEVICE_REST_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/alerting/ {
        proxy_pass http://${ALERTING_REST_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri /index.html;
    }
}
